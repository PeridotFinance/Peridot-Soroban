# DATABASE_URL=postgresql://keeper:password@database-host:25060/margin_keeper
# DATABASE_CA_FILE=/run/secrets/database-ca.pem
# EXPECTED_CONTROLLER_WASM_HASH=<reviewed-64-character-lowercase-sha256>
