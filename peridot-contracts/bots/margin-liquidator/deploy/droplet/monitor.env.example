NOTIFY=false
HEARTBEAT_MAX_AGE=180
# Configure the DEDICATED funded Mainnet keeper public address before live mode.
# Never use the deployer/treasury here to mask an unfunded keeper.
KEEPER_PUBLIC_KEY=
MIN_WALLET_XLM=5
TELEGRAM_TOKEN_FILE=/etc/peridot-stellar-margin/telegram-token
TELEGRAM_CHAT_ID_FILE=/etc/peridot-stellar-margin/telegram-chat-id
