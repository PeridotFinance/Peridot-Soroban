t" href="/bridges/usdt-stellar-to-arbitrum"><span class="MuiBox-root css-oiv2ej">Arbitrum</span><span class="MuiBox-root css-pkn59o">$6k</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-polygon"><span class="MuiBox-root css-oiv2ej">Polygon</span><span class="MuiBox-root css-pkn59o">$16</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-flare"><span class="MuiBox-root css-oiv2ej">Flare</span><span class="MuiBox-root css-pkn59o">$10</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-optimism"><span class="MuiBox-root css-oiv2ej">Optimism</span><span class="MuiBox-root css-pkn59o">$1</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-hedera"><span class="MuiBox-root css-oiv2ej">Hedera</span><span class="MuiBox-root css-pkn59o">$0</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-monad"><span class="MuiBox-root css-oiv2ej">Monad</span><span class="MuiBox-root css-pkn59o">$0</span></a><a class="MuiBox-root css-3equ5t" href="/bridges/usdt-stellar-to-plasma"><span class="MuiBox-root css-oiv2ej">Plasma</span><span class="MuiBox-root css-pkn59o">$0</span></a></div></div></div></div><div class="MuiBox-root css-17cjbap" aria-hidden="true"></div></div><button class="MuiBox-root css-h3e8td" type="button">Load more</button></div></div></section><section class="MuiBox-root css-mtwz3o"><div class="MuiBox-root css-1tnh8wr"><h2 class="MuiBox-root css-1acsvo8">Explore Other Chains</h2><div class="MuiBox-root css-1guhf5k"><div class="MuiBox-root css-1jke4yk"><div class="MuiBox-root css-29f8z6"><div class="MuiBox-root css-11pcms2"><a class="MuiBox-root css-14ub7ko" href="/ecosystem/arbitrum"><span class="MuiBox-root css-rtzvpg">Arbitrum</span><div class="MuiBox-root css-axw7ok"><span class="MuiBox-root css-h300a0" role="img" aria-label="Supported assets: USDT0, XAUT0"><div class="MuiBox-root css-f58l0t"></div><div class="MuiBox-root css-mvrgvo"></div></span></div></