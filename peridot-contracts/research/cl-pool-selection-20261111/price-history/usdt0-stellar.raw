edium);letter-spacing:-0.02em;color:var(--sds-clr-gray-12)}#content-area .prose{color:var(--sds-clr-gray-11);font-size:var(--sds-fs-primary);line-height:1.6}#content-area .prose p,#content-area .prose li{color:var(--sds-clr-gray-11);line-height:1.6}#content-area .prose strong,#content-area .prose b{color:var(--sds-clr-gray-12);font-weight:var(--sds-fw-semi-bold)}#content-area .prose h2,#content-area .prose h3,#content-area .prose h4,#content-area .prose h5{font-family:var(--sds-ff-heading);font-weight:var(--sds-fw-medium);color:var(--sds-clr-gray-12);letter-spacing:-0.01em}#content-area .prose h2{font-size:1.5rem;line-height:2rem;margin-top:2.5rem;margin-bottom:1rem}#content-area .prose h3{font-size:1.25rem;line-height:1.75rem;margin-top:2rem;margin-bottom:0.75rem}#content-area .prose h4{font-size:1.125rem;line-height:1.625rem}#content-area .prose h5{font-size:1rem;line-height:1.5rem;font-weight:var(--sds-fw-semi-bold)}#content-area .prose a:not([class*=\"card\"]):not([data-component-part]):not(.sds *),#content-area .prose a.link:not(.sds *){color:var(--sds-clr-lilac-11);font-weight:var(--sds-fw-medium);text-decoration:none;border-bottom:0;transition:color var(--sds-anim-transition-default)}#content-area .prose a:not([class*=\"card\"]):not([data-component-part]):not(.sds *):hover,#content-area .prose a.link:not(.sds *):hover{color:var(--sds-clr-lilac-12);text-decoration:underline;text-underline-offset:0.2em}#content-area .prose :not(pre)>code{font-family:var(--sds-ff-monospace);font-size:0.875em;font-weight:var(--sds-fw-regular);color:var(--sds-clr-gray-12);background-color:var(--sds-clr-gray-03);border:1px solid var(--sds-clr-gray-06);border-radius:0.25rem;padding:0.0625rem 0.25rem}#content-area .prose table{font-size:var(--sds-fs-secondary);line-height:1.25rem;border-collapse:collapse}#content-area .prose thead th{color:var(--sds-clr-gray-11);font-weight:var(--sds-fw-medium);font-size:0.75rem;line-height:1.125rem;text-transform:uppercase;letter-spacing:0.02em;border-bottom:1px solid var(--sds-clr-gray-06);padding:0.5rem 0.75rem}#content-area .prose tbody td{color:var(--sds-clr-gray-12);border-bottom:1px solid var(--sds-clr-gray-04);padding:0.625rem 0.75rem;vertical-align:top}#content-area .prose tbody tr:last-child td{border-bottom:0}#content-area .prose hr{border-color:var(--sds-clr-gray-04)}#content-area .prose blockquote{border-left:2px solid var(--sds-clr-gray-06);color:var(--sds-clr-gray-11);font-style:normal}#navigation-items a,#table-of-contents a{font-size:var(--sds-fs-secondary);font-weight:var(--sds-fw-medium);color:var(--sds-clr-gray-11)}#navigation-items a:hover,#table-of-contents a:hover,#navigation-items a[aria-current],#table-of-contents a[aria-current]{color:var(--sds-clr-gray-12)}.sds-inline-icon{display:inline-flex;vertical-align:-0.15em;width:1em;height:1em;color:var(--sds-clr-gray-12)}.sds-inline-icon svg{width:100%;height:100%}"},{"filePath":"sds-icons.css","content":"[style*=\"/file-lines.svg\"]{-webkit-mask-image:url(\"/img/sds-icons/icons-file-04.svg\")!important;mask-image:url(\"/img/sds-icons/icons-file-04.svg\")!important;-webkit-mask-size:contain!important;mask-size:contain!important}[style*=\"/box-archive.svg\"]{-webkit-mask-image:url(\"/img/sds-icons/icons-folder.svg\")!important;mask-image:url(\"/img/sds-icons/icons-folder.svg\")!important;-webkit-mask-size:contain!important;mask-size:contain!important}[style*=\"/house.svg\"]{-webkit-mask-image:url(\"/img/sds-icons/icons-home-05.svg\")!important;mask-image:url(\"/img/sds-icons/icons-home-05.svg\")!important;-webkit-mask-size:contain!important;mask-size:contain!important}[style*=\"/magnifying-glass.svg\"]{-webkit-mask-image:url(\"/img/sds-icons/icons-search-md.svg\")!important;mask-image:url(\"/img/sds-icons/icons-search-md.svg\")!important;-webkit-mask-size:contain!important;mask-size:contain!important}[style*=\"/ellipsis-vertical.svg\"]{-webkit-mask-image:url(\"/img/sds-icons/icons-dots-vertical.svg\")!important;mask-image:url(\"/img/sds-icons