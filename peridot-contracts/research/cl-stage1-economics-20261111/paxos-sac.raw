td p{margin:0!important;padding:0!important}td img{display:inline!important;margin:0!important;vertical-align:text-bottom!important}#stablecoins-table td{vertical-align:middle}#stablecoins-table .net{display:inline-block;border-radius:9999px;padding:2px 8px 2px 4px;transition:opacity 0.15s;cursor:default}#stablecoins-table tbody:has(.net:hover) .net{opacity:0.3}#stablecoins-table tbody:has(.net-ethereum:hover) .net-ethereum,#stablecoins-table tbody:has(.net-solana:hover) .net-solana,#stablecoins-table tbody:has(.net-arbitrum:hover) .net-arbitrum,#stablecoins-table tbody:has(.net-stellar:hover) .net-stellar,#stablecoins-table tbody:has(.net-base:hover) .net-base,#stablecoins-table tbody:has(.net-polygon:hover) .net-polygon,#stablecoins-table tbody:has(.net-ink:hover) .net-ink,#stablecoins-table tbody:has(.net-mantle:hover) .net-mantle,#stablecoins-table tbody:has(.net-stable:hover) .net-stable,#stablecoins-table tbody:has(.net-xlayer:hover) .net-xlayer,#stablecoins-table tbody:has(.net-robinhood:hover) .net-robinhood,#stablecoins-table tbody:has(.net-avalanche:hover) .net-avalanche{opacity:1}:root:root{--paxos-font-sans: "Suisse Intl", "Geist", -apple-system, BlinkMacSystemFont,
    "Segoe UI", system-ui, sans-serif;--paxos-font-mono: "Suisse Intl Mono", "Geist Mono", ui-monospace,
    SFMono-Regular, Menlo, monospace;--font-family-headings-custom: var(--paxos-font-sans);--font-family-body-custom: var(--paxos-font-sans)}@font-face{font-family:"Suisse Intl";src:url("/fonts/SuisseIntl-Semibold.woff2") format("woff2");font-weight:500 700;font-style:normal;font-display:swap}@font-face{font-family:"Suisse Intl Mono";src:url("/fonts/SuisseIntlMono-Regular.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}code,pre,kbd,samp,.font-mono{font-family:var(--paxos-font-mono)!important}:root{--paxos-ink: #1f2013;--paxos-cream: #eff0ee;--paxos-charcoal: #585855;--paxos-border-light: #e4e6e2;--paxos-border-dark: #30302e;--paxos-input-light: #858a80;--paxos-input-dark: #76786f;--paxos-muted-dark: #c4c4be;--paxos-surface-light: #eff0ee;--paxos-surface-dark: #1f1f1d;--paxos-card-dark: #111110;--paxos-accent: #1f2013;--paxos-accent-dark: #eff0ee;--paxos-link-hover: #009d52;--paxos-link-hover-dark: #60c177;--paxos-aa-accent: 31 32 19;--paxos-btn-bg: #1f2013;--paxos-btn-bg-hover: #585855;--paxos-btn-bg-dark: #eff0ee;--paxos-btn-bg-dark-hover: #e4e6e2;--paxos-btn-fg: #ffffff;--paxos-btn-fg-dark: #1f2013;--paxos-callout-tip-bg: rgba(37, 147, 78, 0.08);--paxos-callout-tip-border: rgba(37, 147, 78, 0.35);--paxos-callout-tip-icon: #1f2013;--paxos-callout-warn-bg: rgba(255, 159, 10, 0.1);--paxos-callout-warn-border: rgba(255, 159, 10, 0.45);--paxos-callout-warn-icon: #1f2013;--paxos-callout-danger-bg: rgba(255, 69, 58, 0.07);--paxos-callout-danger-border: rgba(255, 69, 58, 0.35);--paxos-callout-danger-icon: #1f2013;--paxos-callout-info-bg: rgba(95, 169, 239, 0.07);--paxos-callout-info-border: rgba(95, 169, 239, 0.35);--paxos-callout-info-icon: #1f2013;--gray-50: 239 240 238;--gray-100: 228 230 226;--gray-200: 208 210 204;--gray-300: 196 196 190;--gray-400: 165 165 159;--gray-500: 133 138 128;--gray-600: 88 88 85;--gray-700: 48 48 46;--gray-800: 31 31 29;--gray-900: 17 17 16;--gray-950: 10 10 10;--default-border-color: 228 230 226;--paxos-radius-c