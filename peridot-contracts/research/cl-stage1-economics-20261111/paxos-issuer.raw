hemes"><code>package main

import (
	&quot;fmt&quot;
	&quot;strings&quot;
	&quot;net/http&quot;
	&quot;io&quot;
)

func main() {

	url := &quot;https://api.paxos.com/v2/transfer/crypto-withdrawals&quot;

	payload := strings.NewReader(&quot;{\n  \&quot;ref_id\&quot;: \&quot;idempotence_id\&quot;,\n  \&quot;profile_id\&quot;: \&quot;b7b77d82-e6a7-4ae9-9904-36231aedf985\&quot;,\n  \&quot;asset\&quot;: \&quot;BTC\&quot;,\n  \&quot;amount\&quot;: \&quot;0.05\&quot;,\n  \&quot;destination_address\&quot;: \&quot;1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2\&quot;,\n  \&quot;metadata\&quot;: {\n    \&quot;my_id\&quot;: \&quot;4024ee50-eefb-4f2e-85c7-e7899c0b7da5\&quot;\n  },\n  \&quot;crypto_network\&quot;: \&quot;BITCOIN\&quot;\n}&quot;)

	req, _ := http.NewRequest(&quot;POST&quot;, url, payload)

	req.Header.Add(&quot;Authorization&quot;, &quot;Bearer &lt;token&gt;&quot;)
	req.Header.Add(&quot;Content-Type&quot;, &quot;application/json&quot;)

	res, _ := http.DefaultClient.Do(req)

	defer res.Body.Close()
	body, _ := io.ReadAll(res.Body)

	fmt.Println(string(body))

}</code></pre></div></div></div></div><div class="code-block-fade-overlay print:hidden" data-fade-overlay="true" aria-hidden="true" style="--fade-color-light:#FFFFFF;--fade-color-dark:#0B0C0E"></div></div><div data-hidden="" data-orientation="horizontal" data-activation-direction="none" hidden="" id="base-ui-_R_39jeehkd74t9_" tabindex="0" inert="" data-index="-1" class="w-full min-w-full max-w-full h-full max-h-full relative focus-visible:outline-hidden before:content-[&#x27;&#x27;] before:absolute before:inset-0 before:z-10 before:pointer-events-none before:rounded-xt focus-visible:before:outline focus-visible:before:outline-1 focus-visible:before:-outline-offset-2 focus-visible:before:outline-primary dark:focus-visible:before:outline-primary-light data-hidden:hidden [&amp;_[data-component-part=code-block-root]]:rounded-xt!"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px;font-variant-ligatures:none;height:100%;background-color:#FFFFFF;--shiki-dark-bg:#0B0C0E" data-component-part="code-block-root" class="w-0 min-w-full max-w-full h-full dark:bg-codeblock text-sm leading-6 transition-[height] duration-300 ease-in-out code-block-background **:ring-0 **:outline-0 **:focus:ring-0 **:focus:outline-0 rounded-xt bg-white"><div data-id="base-ui-_R_f9jeehkd74t9_-viewport" tabindex="0" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] py-3.5 px-4 focus-visible:outline-1! focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-full! h-full children:my-0! children:shadow-none! children:bg-transparent!"><div class="font-mono whitespace-pre flex-none h-full text-xs leading-[1.35rem]" data-component-part="code-group-tab-content"><pre class="shiki shiki-t