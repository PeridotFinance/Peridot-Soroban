D asset 3. Confirm the trustline is active before requesting withdrawal Verifying Trustline Status: You can verify if an address has the required trustline by: - Using Stellar blockchain explorers (e.g., stellar.expert) - Querying the Stellar Horizon API - Using the Stellar SDK to check account balances","url":"https://docs.paxos.com/api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal","mainEntityOfPage":{"@id":"https://docs.paxos.com/api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal#webpage"},"dateModified":"2026-10-29T00:08:01.343Z","publisher":{"@id":"https://docs.paxos.com/#organization"},"isPartOf":{"@id":"https://docs.paxos.com#website"}}]}</script><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/index-Ci4fHCFS.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/rolldown-runtime-Bjp52BOI.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/initial-vendor-BbwvMI54.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/OpenApiReferenceProvider-C9Wu0MeN.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/utils-jWgu-6Qf.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/cloneDeep-izs3Hzxb.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/_Uint8Array-BVIqJ90l.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/isObjectLike-C8vmzPEN.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/isArray-Dcu1dQ5t.js?dpl=dpl_596ePT575z4qnAFksq1biRW97aLY"><link rel="modulepreload" fetchpriority="low" href="/_mintlify/assets/utils-DBD8f9qn.js?dpl=dpl_596ePT575z4qnAF