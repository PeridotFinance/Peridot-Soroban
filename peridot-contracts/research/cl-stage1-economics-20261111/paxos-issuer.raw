/oauth2/token\n- Sandbox: https://oauth.sandbox.paxos.com/oauth2/token\n\nLearn more in the [API credentials guide →](https://docs.paxos.com/developer/credentials)\n","format":"bearer","typeLabel":"string\u003cbearer>","deprecated":false},"schemeName":"OAuth2","name":"Authorization"}],"title":"OAuth2"}]},"originalFileLocation":"https://developer.paxos.com/docs/paxos-v2.openapi.json"},"subdomain":"paxos-0ac97319","siteName":"Paxos Documentation","title":"Create Crypto Withdrawal - Paxos Documentation","navMaps":{"firstHrefInVersion":{},"firstHrefInLanguage":{}},"lastModified":"2026-10-29T00:08:01.343Z","originalFileLocation":"api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal.mdx"},"headHtml":"\u003cscript data-mint-head>(function(){var d=document.documentElement,p=null;if(!p){try{p=localStorage.getItem(\"isDarkMode\")}catch(e){}if(p==='true')p='dark';else if(p==='false')p='light';if(p!=='light'\u0026\u0026p!=='dark'\u0026\u0026p!=='system')p=\"light\"}var r=p==='system'?(matchMedia(\"(prefers-color-scheme: dark)\").matches?'dark':'light'):p;d.classList.remove(r==='dark'?'light':'dark');d.classList.add(r);d.setAttribute(\"data-theme-preference\",p)})();\u003c/script>\u003cmeta data-mint-head name=\"description\" content=\"Withdraw a cryptocurrency asset to a specified destination address. A request to create a crypto withdrawal can fail with one of the following types of errors: - Travel Rule Information Required if the withdrawal requires Travel Rule information and the destination address is missing it. Important for Stellar Network (PYUSD): When withdrawing PYUSD on the Stellar network, the destination address must have an established trustline with the PYUSD issuer: - PYUSD Issuer: GDQE7IXJ4HUHV6RQHIUPRJSEZE4DRS5WY577O2FY6YQ5LVWZ7JZTU2V5 (mainnet) - Asset Code: PYUSD How to Establish a Trustline: The recipient must use a Stellar wallet or the Stellar SDK to: 1. Ensure their account has minimum XLM balance (at least 1 XLM recommended) 2. Create a trustline to the PYUSD issuer for the PYUSD asset 3. Confirm the trustline is active before requesting withdrawal Verifying Trustline Status: You can verify if an address has the required trustline by: - Using Stellar blockchain explorers (e.g., stellar.expert) - Querying the Stellar Horizon API - Using the Stellar SDK to check account balances\">\u003cmeta data-mint-head name=\"application-name\" content=\"Paxos Documentation\">\u003cmeta data-mint-head name=\"generator\" content=\"Mintlify\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/android-chrome-192x192.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/apple-touch-icon.png\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/favicon-16x16.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/favicon-32x32.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/favicon.ico\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon-dark/android-chrome-192x192.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon-dark/favicon-16x16.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon-dark/favicon-32x32.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon-dark/favicon.ico\" media=\"(prefers-color-scheme: dark)\">\u003cmeta data-mint-head property=\"og:title\" content=\"Create Crypto Withdrawal - Paxos Documentation\">\u003cmeta data-mint-head property=\"og:description\" content=\"Withdraw a cryptocurrency asset to a specified destination address. A request to create a crypto withdrawal can fail with one of the following types of errors: - Travel Rule Information Required if the withdrawal requires Travel Rule information and the destination address is missing it. Important for Stellar Network (PYUSD): When withdrawing PYUSD on the Stellar network, the destination address must have an established trustline with the PYUSD issuer: - PYUSD Issuer: GDQE7IXJ4HUHV6RQHIUPRJSEZE4DRS5WY577O2FY6YQ5LVWZ7JZTU2V5 (mainnet) - Asset Code: PYUSD How to Establish a Trustline: The recipient must use a Stellar wallet or the Stellar SDK to: 1. Ensure their account has minimum XLM balance (at least 1 XLM recommended) 2. Create a trustline to the PYUSD issuer for the PYUSD asset 3. Confirm the trustline is active before requesting withdrawal Verifying Trustline Status: You can verify if an address has the required trustline by: - Using Stellar blockchain explorers (e.g., stellar.expert) - Querying the Stellar Horizon API - Using the Stellar SDK to check account balances\">\u003cmeta data-mint-head property=\"og:site_name\" content=\"Paxos Documentation\">\u003cmeta data-mint-head property=\"og:url\" content=\"https://docs.paxos.com/api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal\">\u003cmeta data-mint-head property=\"og:type\" content=\"website\">\u003cmeta data-mint-head property=\"og:image\" content=\"https://paxos-0ac97319.mintlify.site/_mintlify/api/og/v2?division=Crypto+Withdrawals\u0026amp;title=Create+Crypto+Withdrawal\u0026amp;description=Withdraw+a+cryptocurrency+asset+to+a+specified+destination+address.%0A%0AA+request+to+create+a+crypto+withdrawal+can+fail+with+one+of+the+following%0Atypes+of+errors%3A\u0026amp;theme=b6d1aef1976546092ed99bbd\u0026amp;signature=1f99385730158633a4a141d88534dd42c2bca0c8da71804657b1dd3ff5e78650\">\u003cmeta data-mint-head property=\"og:image:width\" content=\"1200\">\u003cmeta data-mint-head property=\"og:image:height\" content=\"630\">\u003cmeta data-mint-head name=\"twitter:card\" content=\"summary_large_image\">\u003cmeta data-mint-head name=\"twitter:title\" content=\"Create Crypto Withdrawal - Paxos Documentation\">\u003cmeta data-mint-head name=\"twitter:description\" content=\"Withdraw a cryptocurrency asset to a specified destination address. A request to create a crypto withdrawal can fail with one of the following types of errors: - Travel Rule Information Required if the withdrawal requires Travel Rule information and the destination address is missing it. Important for Stellar Network (PYUSD): When withdrawing PYUSD on the Stellar network, the destination address must have an established trustline with the PYUSD issuer: - PYUSD Issuer: GDQE7IXJ4HUHV6RQHIUPRJSEZE4DRS5WY577O2FY6YQ5LVWZ7JZTU2V5 (mainnet) - Asset Code: PYUSD How to Establish a Trustline: The recipient must use a Stellar wallet or the Stellar SDK to: 1. Ensure their account has minimum XLM balance (at least 1 XLM recommended) 2. Create a trustline to the PYUSD issuer for the PYUSD asset 3. Confirm the trustline is active before requesting withdrawal Verifying Trustline Status: You can verify if an address has the required trustline by: - Using Stellar blockchain explorers (e.g., stellar.expert) - Querying the Stellar Horizon API - Using the Stellar SDK to check account balances\">\u003cmeta data-mint-head name=\"twitter:image\" content=\"https://paxos-0ac97319.mintlify.site/_mintlify/api/og/v2?division=Crypto+Withdrawals\u0026amp;title=Create+Crypto+Withdrawal\u0026amp;description=Withdraw+a+cryptocurrency+asset+to+a+specified+destination+address.%0A%0AA+request+to+create+a+crypto+withdrawal+can+fail+with+one+of+the+following%0Atypes+of+errors%3A\u0026amp;theme=b6d1aef1976546092ed99bbd\u0026amp;signature=1f99385730158633a4a141d88534dd42c2bca0c8da71804657b1dd3ff5e78650\">\u003cmeta data-mint-head name=\"twitter:image:width\" content=\"1200\">\u003cmeta data-mint-head name=\"twitter:image:height\" content=\"630\">\u003cmeta data-mint-head name=\"msapplication-config\" content=\"/mintlify-assets/_mintlify/favicons/paxos-0ac97319/KhdpLWAO0J1EQrKl/_generated/favicon/browserconfig.xml\">\u003cmeta data-mint-head name=\"apple-mobile-web-app-title\" content=\"Paxos Documentation\">\u003cmeta data-mint-head name=\"msapplication-TileColor\" content=\"#1F2013\">\u003clink data-mint-head rel=\"canonical\" href=\"https://docs.paxos.com/api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal\">\u003clink data-mint-head rel=\"alternate\" type=\"application/xml\" href=\"/sitemap.xml\">\u003clink data-mint-head rel=\"alternate\" type=\"text/markdown\" href=\"/api-reference/endpoints/crypto-withdrawals/create-crypto-withdrawal.md\">\u003cscript data-mint-head type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://docs.paxos.com/#organization\",\"name\":\"Paxos Documentation\",\"url\":\"https://docs.paxos.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://mintcdn.com/paxos-0ac97319/FynHAWvyJ0n2koTG/logo/light.svg?fit=max\u0026auto=format\u0026n=FynHAWvyJ0n2koTG\u0026q=85\u0026s=355d40c8d0ca4e30c4e977283cd0dcd0\"}},{\"@type\":\"WebSite\",\"@id\":\"https://docs.paxos.com#website\",\