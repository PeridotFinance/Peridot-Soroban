eKey":"total","typeLabel":"string\u003cdecimal>"},"fee":{"type":"string","format":"decimal","description":"The fee paid for the transfer.","pattern":"^[0-9]*\\.?[0-9]+$","isRequired":true,"uniqueKey":"fee","typeLabel":"string\u003cdecimal>"},"asset":{"type":"string","description":"The asset for this transfer. This profile's balance of this asset will be debited or credited.","isRequired":true,"uniqueKey":"asset","typeLabel":"string"},"direction":{"type":"string","enum":["CREDIT","DEBIT"],"description":"Direction of the transfer.","isRequired":true,"uniqueKey":"direction","typeLabel":"enum\u003cstring>"},"type":{"type":"string","enum":["INTERNAL_TRANSFER_DEBIT","INTERNAL_TRANSFER_CREDIT","CRYPTO_DEPOSIT","CRYPTO_WITHDRAWAL","WIRE_DEPOSIT","WIRE_WITHDRAWAL","SEN_DEPOSIT","SEN_WITHDRAWAL","BANK_DEPOSIT","BANK_WITHDRAWAL","PAXOS_TRANSFER_DEBIT","PAXOS_TRANSFER_CREDIT","SIGNET_DEPOSIT","SIGNET_WITHDRAWAL","CBIT_WITHDRAWAL","CBIT_DEPOSIT","CUBIX_DEPOSIT","CUBIX_WITHDRAWAL","RTP_DEPOSIT"],"description":"Type of transfer.","isRequired":true,"uniqueKey":"type","typeLabel":"enum\u003cstring>"},"status":{"type":"string","enum":["PENDING","COMPLETED","FAILED"],"isRequired":true,"uniqueKey":"status","typeLabel":"enum\u003cstring>"},"created_at":{"type":"string","format":"date-time","description":"The time at which this transfer record was created.","isRequired":true,"uniqueKey":"created_at","typeLabel":"string\u003cdate-time>"},"updated_at":{"type":"string","format":"date-time","description":"The time at which this transfer record was most recently updated.","isRequired":true,"uniqueKey":"updated_at","typeLabel":"string\u003cdate-time>"},"identity_id":{"type":"string","description":"The Paxos ID of the Identity associated with the transfer.","uniqueKey":"identity_id","typeLabel":"string"},"ref_id":{"type":"string","description":"The optional client-specified ID for replay protection and lookup.","uniqueKey":"ref_id","typeLabel":"string"},"balance_asset":{"type":"string","description":"The balance_asset represents what asset's balance was affected at Paxos with this transfer. It only differs from Asset when the transfer includes conversion.","uniqueKey":"balance_asset","typeLabel":"string"},"secondary_status":{"type":"object","properties":{"name":{"type":"string","enum":["TRAVEL_RULE_INFO_REQUESTED","TRAVEL_RULE_REJECTED","CUSTOMER_REJECTED","PENDING_CUSTOMER_APPROVAL","VASP_RESTRICTED"],"description":"Identifier for secondary status.\n\n - TRAVEL_RULE_INFO_REQUESTED: Travel rule information is required to continue processing the transfer.\n - TRAVEL_RULE_REJECTED: Transfer has been terminally rejected due to failing travel rule checks.\n - CUSTOMER_REJECTED: Transfer was rejected by a customer.\n - PENDING_CUSTOMER_APPROVAL: Transfer is pending customer approval.\n - VASP_RESTRICTED: Transfer rejected because the destination VASP is restricted for the legal entity.","uniqueKey":"secondary_status.name","typeLabel":"enum\u003cstring>"},"detail":{"type":"string","description":"Additional information about the current status of the transfer (e.g. if information is missing).","uniqueKey":"secondary_status.detail","typeLabel":"string"}},"description":"Secondary status for the transfer, used for more granular explanation of the transfer status.","uniqueKey":"secondary_status","typeLabel":"object"},"status_details":{"type":"object","properties":{"missing_trustline":{"type":"object","properties":{"message":{"type":"string","title":"Human-readable explanation of the error","uniqueKey":"status_details.missing_trustline.message","typeLabel":"string"},"destination_address":{"type":"string","title":"The destination account address that is missing the trustline","uniqueKey":"status_details.missing_trustline.destination_address","typeLabel":"string"},"asset":{"type":"string","title":"The asset that requires a trustline","uniqueKey":"status_details.missing_trustline.asset","typeLabel":"string"}},"description":"MissingTrustline represents a failed transfer where the destination account\nlacks the required asset trustline.","uniqueKey":"status_details.missing_trustline","typeLabel":"object"},"max_rent_exceeded":{"type":"object","properties":{"message":{"type":"string","title":"Human-readable explanation of the error","uniqueKey":"status_details.max_rent_exceeded.message","typeLabel":"string"},"destination_address":{"type":"string","title":"The destination account address that triggered the check","uniqueKey":"status_details.max_rent_exceeded.destination_address","typeLabel":"string"}},"description":"MaxRentExceeded represents a failed transfer that was flagged for system abuse.\nWhen a withdrawal's rent calculation for the destination account exceeds the\nmaximum allowed rent threshold, it may indicate malicious behavior. This status\ndetail is set when such transfers are automatically cancelled.","uniqueKey":"status_details.max_rent_exceeded","typeLabel":"object"},"pending_customer_approval":{"type":"object","properties":{"message":{"type":"string","title":"Human-readable explanation","uniqueKey":"status_details.pending_customer_approval.message","typeLabel":"string"},"awaiting_action_from":{"type":"string","enum":["AWAITING_ACTION_FROM_UNSPECIFIED","AWAITING_ACTION_FROM_CLIENT","AWAITING_ACTION_FROM_PAXOS"],"description":"AwaitingActionFrom indicates who needs to act on or is responsible for a given status.\n\n - AWAITING_ACTION_FROM_CLIENT: The customer needs to take action.\n - AWAITING_ACTION_FROM_PAXOS: Paxos needs to take action.","uniqueKey":"status_details.pending_customer_approval.awaiting_action_from","typeLabel":"enum\u003cstring>"}},"description":"PendingCustomerApproval represents that this resource is awaiting customer approval.","uniqueKey":"status_details.pending_customer_approval","typeLabel":"object"},"stale_fee_quote":{"type":"object","properties":{"message":{"type":"string","title":"Human-readable explanation","uniqueKey":"status_details.stale_fee_quote.message","typeLabel":"string"}},"description"