+// Isolated Option1 research only: no production adoption or Mainnet route.
+#[cfg(feature = "funded-liquidation-validation")]
+#[contractimpl]
+impl MarginController {
+    /// Unadopted design: expired swapped pending positions may be settled by an
+    /// independent payer at current value with ZERO incentive. No activation.
+    pub fn recover_expired_pending_funded(
+        env: Env,
+        payer: Address,
+        position_id: u64,
+        max_repay: u128,
+        min_seize_underlying: u128,
+    ) -> (u128, u128) {
