+/// Fresh price reads do not consume governance defaults or the market registry.
+/// Per-token support, symbol and cache keys are maintained by their existing
+/// dedicated helpers inside cache_price. All validation/call paths are retained.
+pub fn bump_price_read_ttl(env: &Env) {
+    let persistent = env.storage().persistent();
+    for key in [DataKey::Oracle, DataKey::OracleMaxAgeMultiplier] {
+        if persistent.has(&key) {
+            persistent.extend_ttl(&key, TTL_THRESHOLD, TTL_EXTEND_TO);
+        }
+    }
+    if env.storage().instance().has(&DataKey::Initialized) {
+        env.storage().instance().extend_ttl(TTL_THRESHOLD, TTL_EXTEND_TO);
+    }
+}
