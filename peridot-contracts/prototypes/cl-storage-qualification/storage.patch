+/// Operation-scoped keepalive. No schema migration or changed defaults: only
+/// keys consumed by this path are renewed; unrelated governance/rate history is
+/// no longer restored merely because a position is repaid or transferred.
+pub fn bump_operation_ttl(env: &Env, keys: &[DataKey]) {
+    let persistent = env.storage().persistent();
+    for key in keys {
+        if persistent.has(key) {
+            persistent.extend_ttl(key, TTL_THRESHOLD, TTL_EXTEND_TO);
+        }
+    }
+}
+
+pub fn ensure_initialized_for_operation(env: &Env, keys: &[DataKey]) -> Address {
+    let token = ensure_initialized_for_snapshot(env);
+    bump_operation_ttl(env, keys);
+    token
+}
