+#![no_std]
+//! ISOLATED LOCAL PROTOTYPE. Never a production escrow or deployment candidate.
+use soroban_sdk::auth::{ContractContext, InvokerContractAuthEntry, SubContractInvocation};
+use soroban_sdk::{
+    contract, contractimpl, contracttype, token, Address, Bytes, BytesN, Env, IntoVal, Symbol, Val,
+    Vec,
+};
+#[contracttype]
+#[derive(Clone)]
+pub struct Config {
+    pub controller: Address,
+    pub share: Address,
+    pub pool: Address,
+    pub underlying: Address,
+    pub other: Address,
+    pub u_idx: u32,
+}
+#[contracttype]
+#[derive(Clone)]
+pub struct Job {
+    pub owner: Address,
+    pub underlying: u128,
+    pub other: u128,
+    pub shares: u128,
+    pub deadline: u64,
+    pub phase: u32,
+    pub fence: Option<BytesN<32>>,
+}
+#[contracttype]
+#[derive(Clone)]
+enum Key {
+    Config,
+    Job(u64),
+}
+fn guard(e: &Env) {
+    assert_ne!(
+        e.ledger().network_id(),
+        e.crypto()
+            .sha256(&Bytes::from_slice(
+                e,
+                b"Public Global Stellar Network ; September 2015"
+            ))
+            .to_bytes(),
+        "prototype Mainnet disabled"
+    );
+}
+fn cfg(e: &Env) -> Config {
+    guard(e);
+    e.storage()
+        .instance()
+        .get(&Key::Config)
+        .expect("uninitialized")
+}
+fn job(e: &Env, id: u64) -> Job {
+    e.storage()
+        .persistent()
+        .extend_ttl(&Key::Job(id), 500_000, 1_000_000);
+    e.storage()
+        .persistent()
+        .get(&Key::Job(id))
+        .expect("job missing")
+}
+fn save(e: &Env, id: u64, j: &Job) {
+    e.storage().persistent().set(&Key::Job(id), j);
+    e.storage()
+        .persistent()
+        .extend_ttl(&Key::Job(id), 500_000, 1_000_000);
+}
+fn amount(v: u128) -> i128 {
+    v.try_into().expect("amount overflow")
+}
+fn invoke<T: soroban_sdk::TryFromVal<Env, Val>>(
+    e: &Env,
+    to: &Address,
+    name: &str,
+    args: Vec<Val>,
+) -> T {
+    e.invoke_contract(to, &Symbol::new(e, name), args)
+}
+fn auth(e: &Env, to: &Address, name: &str, args: Vec<Val>) -> InvokerContractAuthEntry {
+    InvokerContractAuthEntry::Contract(SubContractInvocation {
+        context: ContractContext {
+            contract: to.clone(),
+            fn_name: Symbol::new(e, name),
+            args,
+        },
+        sub_invocations: Vec::new(e),
+    })
+}
+fn access(e: &Env, c: &Config, id: u64, phase: u32, live: bool) -> Job {
+    c.controller.require_auth();
+    let j = job(e, id);
+    assert_eq!(j.phase, phase, "wrong phase");
+    if live {
+        assert!(e.ledger().timestamp() <= j.deadline, "job expired");
+    }
+    j
+}
+#[contract]
+pub struct SplitEscrow;
+#[contractimpl]
+impl SplitEscrow {
+    pub fn initialize(e: Env, admin: Address, controller: Address, share: Address) {
+        guard(&e);
+        assert!(
+            !e.storage().instance().has(&Key::Config),
+            "already initialized"
+        );
+        admin.require_auth();
+        let (pool, underlying, other, u_idx): (Address, Address, Address, u32) =
+            invoke(&e, &share, "split_assets", ().into_val(&e));
+        assert!(u_idx < 2);
+        e.storage().instance().set(
+            &Key::Config,
+            &Config {
+                controller,
+                share,
+                pool,
+                underlying,
+                other,
+                u_idx,
+            },
+        );
+    }
+    pub fn config(e: Env) -> Config {
+        cfg(&e)
+    }
+    pub fn get_job(e: Env, id: u64) -> Job {
+        guard(&e);
+        job(&e, id)
+    }
+    pub fn fund(e: Env, id: u64, owner: Address, underlying: u128, deadline: u64) {
+        let c = cfg(&e);
+        c.controller.require_auth();
+        assert!(!e.storage().persistent().has(&Key::Job(id)), "job exists");
+        assert!(underlying > 0 && e.ledger().timestamp() <= deadline);
+        let t = token::Client::new(&e, &c.underlying);
+        let me = e.current_contract_address();
+        let before = t.balance(&me);
+        t.transfer(&c.controller, &me, &amount(underlying));
+        assert_eq!(
+            t.balance(&me) - before,
+            amount(underlying),
+            "funding mismatch"
+        );
+        save(
+            &e,
+            id,
+            &Job {
+                owner,
+                underlying,
+                other: 0,
+                shares: 0,
+                deadline,
+                phase: 1,
+                fence: None,
+            },
+        );
+    }
+    pub fn convert(e: Env, id: u64, input: u128, min_out: u128) -> u128 {
+        let c = cfg(&e);
+        let mut j = access(&e, &c, id, 1, true);
+        assert!(
+            input > 0 && input < j.underlying && min_out > 0,
+            "invalid conversion"
+        );
+        let guarded: u128 = invoke(&e, &c.share, "split_quote_convert", (input,).into_val(&e));
+        assert!(guarded > 0, "conversion floor unavailable");
+        let min_out = min_out.max(guarded);
+        let me = e.current_contract_address();
+        let tu = token::Client::new(&e, &c.underlying);
+        let to = token::Client::new(&e, &c.other);
+        let bu = tu.balance(&me);
+        let bo = to.balance(&me);
+        e.authorize_as_current_contract(soroban_sdk::vec![
+            &e,
+            auth(
+                &e,
+                &c.underlying,
+                "transfer",
+                (me.clone(), c.pool.clone(), amount(input)).into_val(&e)
+            )
+        ]);
+        let out: u128 = invoke(
+            &e,
+            &c.pool,
+            "swap",
+            (me.clone(), c.u_idx, 1 - c.u_idx, input, min_out).into_val(&e),
+        );
+        assert_eq!(bu - tu.balance(&me), amount(input));
+        assert_eq!(to.balance(&me) - bo, amount(out));
+        assert!(out >= min_out);
+        j.underlying -= input;
+        j.other = out;
+        j.phase = 2;
+        save(&e, id, &j);
+        out
+    }
+    pub fn prepare(e: Env, id: u64) -> BytesN<32> {
+        let c = cfg(&e);
+        c.controller.require_auth();
+        let mut j = job(&e, id);
+        assert!(j.phase == 2 || j.phase == 3, "wrong phase");
+        assert!(e.ledger().timestamp() <= j.deadline, "job expired");
+        let fence: BytesN<32> = invoke(
+            &e,
+            &c.share,
+            "split_prepare",
+            (e.current_contract_address(), id, j.deadline).into_val(&e),
+        );
+        j.fence = Some(fence.clone());
+        j.phase = 3;
+        save(&e, id, &j);
+        fence
+    }
+    pub fn mint(e: Env, id: u64, min_shares: u128) -> u128 {
+        let c = cfg(&e);
+        let mut j = access(&e, &c, id, 3, true);
+        assert!(min_shares > 0);
+        let me = e.current_contract_address();
+        let au = j.underlying;
+        let ao = j.other;
+        let bu = token::Client::new(&e, &c.underlying).balance(&me);
+        let bo = token::Client::new(&e, &c.other).balance(&me);
+        let bs = token::Client::new(&e, &c.share).balance(&me);
+        let assigned_before: u128 = invoke(
+            &e,
+            &c.share,
+            "custody_allocation",
+            (me.clone(), j.owner.clone()).into_val(&e),
+        );
+        let tu = auth(
+            &e,
+            &c.underlying,
+            "transfer",
+            (me.clone(), c.share.clone(), amount(au)).into_val(&e),
+        );
+        let to = auth(
+            &e,
+            &c.other,
+            "transfer",
+            (me.clone(), c.share.clone(), amount(ao)).into_val(&e),
+        );
+        let args: Vec<Val> = (
+            me.clone(),
+            j.owner.clone(),
+            id,
+            au,
+            ao,
+            min_shares,
+            j.fence.clone().unwrap(),
+        )
+            .into_val(&e);
+        e.authorize_as_current_contract(soroban_sdk::vec![
+            &e,
+            tu.clone(),
+            to.clone(),
+            InvokerContractAuthEntry::Contract(SubContractInvocation {
+                context: ContractContext {
+                    contract: c.share.clone(),
+                    fn_name: Symbol::new(&e, "split_deposit_pair"),
+                    args: args.clone()
+                },
+                sub_invocations: soroban_sdk::vec![&e, tu, to]
+            })
+        ]);
+        let minted: i128 = invoke(&e, &c.share, "split_deposit_pair", args);
+        assert!(minted > 0 && minted >= amount(min_shares));
+        assert_eq!(
+            bu - token::Client::new(&e, &c.underlying).balance(&me),
+            amount(au)
+        );
+        assert_eq!(
+            bo - token::Client::new(&e, &c.other).balance(&me),
+            amount(ao)
+        );
+        assert_eq!(token::Client::new(&e, &c.share).balance(&me) - bs, minted);
+        let assigned: u128 = invoke(
+            &e,
+            &c.share,
+            "custody_allocation",
+            (me, j.owner.clone()).into_val(&e),
+        );
+        assert_eq!(
+            assigned,
+            assigned_before.checked_add(minted as u128).unwrap(),
+            "beneficiary assignment delta mismatch"
+        );
+        j.underlying = 0;
+        j.other = 0;
+        j.shares = minted as u128;
+        j.phase = 4;
+        save(&e, id, &j);
+        minted as u128
+    }
+    pub fn deliver(e: Env, id: u64) -> u128 {
+        let c = cfg(&e);
+        let mut j = access(&e, &c, id, 4, false);
+        let me = e.current_contract_address();
+        invoke::<()>(
+            &e,
+            &c.share,
+            "custody_prepare_transfer",
+            (
+                me.clone(),
+                j.owner.clone(),
+                c.controller.clone(),
+                j.shares,
+                false,
+            )
+                .into_val(&e),
+        );
+        token::Client::new(&e, &c.share).transfer(&me, &c.controller, &amount(j.shares));
+        let out = j.shares;
+        j.shares = 0;
+        j.phase = 5;
+        save(&e, id, &j);
+        out
+    }
+    /// Only the controller can authorize this AFTER atomic full debt repayment.
+    pub fn release(e: Env, id: u64, owner: Address) -> Vec<u128> {
+        let c = cfg(&e);
+        c.controller.require_auth();
+        let mut j = job(&e, id);
+        assert!(j.phase >= 1 && j.phase <= 4, "job not recoverable");
+        assert_eq!(j.owner, owner, "wrong beneficiary");
+        let me = e.current_contract_address();
+        if j.shares > 0 {
+            invoke::<()>(
+                &e,
+                &c.share,
+                "custody_prepare_transfer",
+                (me.clone(), owner.clone(), owner.clone(), j.shares, true).into_val(&e),
+            );
+            token::Client::new(&e, &c.share).transfer(&me, &owner, &amount(j.shares));
+        }
+        if j.underlying > 0 {
+            token::Client::new(&e, &c.underlying).transfer(&me, &owner, &amount(j.underlying));
+        }
+        if j.other > 0 {
+            token::Client::new(&e, &c.other).transfer(&me, &owner, &amount(j.other));
+        }
+        let out = soroban_sdk::vec![&e, j.underlying, j.other, j.shares];
+        j.underlying = 0;
+        j.other = 0;
+        j.shares = 0;
+        j.phase = 6;
+        save(&e, id, &j);
+        out
+    }
+}
