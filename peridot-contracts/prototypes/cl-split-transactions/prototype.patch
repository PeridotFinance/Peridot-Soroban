+//! ISOLATED LOCAL PROTOTYPE ONLY: explicit owner-funded escrow stages.
+use crate::{
+    contract::MarginController, fees::get_fee_terms, helpers::*, storage::*, MarginControllerArgs,
+    MarginControllerClient,
+};
+use soroban_sdk::{
+    contractimpl, contracttype, token, Address, BytesN, Env, IntoVal, Symbol, Val, Vec,
+};
+#[contracttype]
+#[derive(Clone)]
+pub struct SplitEscrowConfig {
+    pub controller: Address,
+    pub share: Address,
+    pub pool: Address,
+    pub underlying: Address,
+    pub other: Address,
+    pub u_idx: u32,
+}
+#[contracttype]
+#[derive(Clone)]
+pub struct SplitOpen {
+    pub owner: Address,
+    pub escrow: Address,
+    pub margin_received: u128,
+    pub phase: u32,
+    pub deadline: u64,
+}
+#[contracttype]
+#[derive(Clone)]
+enum Key {
+    Escrow,
+    Job(u64),
+}
+fn invoke<T: soroban_sdk::TryFromVal<Env, Val>>(
+    e: &Env,
+    to: &Address,
+    name: &str,
+    args: Vec<Val>,
+) -> T {
+    e.invoke_contract(to, &Symbol::new(e, name), args)
+}
+fn guard(e: &Env) {
+    crate::funded_liquidation::require_validation_network(e);
+}
+fn record(e: &Env, id: u64) -> SplitOpen {
+    let k = Key::Job(id);
+    assert!(e.storage().persistent().has(&k), "split missing");
+    e.storage().persistent().extend_ttl(&k, 500_000, 1_000_000);
+    e.storage().persistent().get(&k).unwrap()
+}
+fn save(e: &Env, id: u64, j: &SplitOpen) {
+    e.storage().persistent().set(&Key::Job(id), j);
+    e.storage()
+        .persistent()
+        .extend_ttl(&Key::Job(id), 500_000, 1_000_000);
+}
+fn owned(e: &Env, owner: &Address, id: u64) -> SplitOpen {
+    guard(e);
+    owner.require_auth();
+    let j = record(e, id);
+    assert_eq!(j.owner, *owner, "not owner");
+    let p = get_position_record_or_panic(e, id);
+    assert_eq!(p.owner, *owner);
+    assert_eq!(p.status, PositionStatus::PendingOpen, "not pending");
+    j
+}
+// These helpers accept a job only after the public root authenticates its
+// owner. Combined execution authenticates once; all phase/deadline checks stay.
+fn convert_job(e: &Env, j: &mut SplitOpen, id: u64, input: u128, min_out: u128) -> u128 {
+    assert_eq!(j.phase, 1);
+    assert!(e.ledger().timestamp() <= j.deadline, "expired");
+    let out: u128 = invoke(e, &j.escrow, "convert", (id, input, min_out).into_val(e));
+    j.phase = 2;
+    save(e, id, j);
+    out
+}
+fn prepare_job(e: &Env, j: &mut SplitOpen, id: u64) -> BytesN<32> {
+    assert!(j.phase == 2 || j.phase == 3, "wrong phase");
+    let fence: BytesN<32> = invoke(e, &j.escrow, "prepare", (id,).into_val(e));
+    j.phase = 3;
+    save(e, id, j);
+    fence
+}
+impl MarginController {
+    pub(crate) fn split_assert_delivered_or_absent(e: &Env, id: u64) {
+        if e.storage().persistent().has(&Key::Job(id)) {
+            assert_eq!(record(e, id).phase, 5, "split collateral not delivered");
+        }
+    }
+    pub(crate) fn split_assert_unfunded(e: &Env, id: u64) {
+        assert!(
+            !e.storage().persistent().has(&Key::Job(id)),
+            "split escrow active"
+        );
+    }
+}
+#[contractimpl]
+impl MarginController {
+    pub fn set_split_escrow(e: Env, admin: Address, escrow: Address) {
+        guard(&e);
+        let expected: Address = e.storage().persistent().get(&DataKey::Admin).unwrap();
+        assert_eq!(admin, expected);
+        admin.require_auth();
+        assert!(!e.storage().instance().has(&Key::Escrow), "escrow fixed");
+        let c: SplitEscrowConfig = invoke(&e, &escrow, "config", ().into_val(&e));
+        assert_eq!(c.controller, e.current_contract_address());
+        assert!(Self::cl_enabled(&e, &c.share));
+        let registered: bool = invoke(&e, &c.share, "is_custodian", (escrow.clone(),).into_val(&e));
+        assert!(registered);
+        e.storage().instance().set(&Key::Escrow, &escrow);
+    }
+    pub fn get_split_open(e: Env, id: u64) -> SplitOpen {
+        guard(&e);
+        record(&e, id)
+    }
+    pub fn split_fund(e: Env, user: Address, id: u64, max_borrow: u128, max_input: u128) {
+        guard(&e);
+        user.require_auth();
+        Self::split_assert_unfunded(&e, id);
+        let (_, pending, vaults) = Self::load_pending_perps_open(&e, &user, id, true);
+        assert!(
+            get_pending_perps_open_execution(&e, id).is_none(),
+            "already swapped"
+        );
+        assert_eq!(pending.side, PositionSide::Long, "prototype long only");
+        let escrow: Address = e
+            .storage()
+            .instance()
+            .get(&Key::Escrow)
+            .expect("escrow missing");
+        let c: SplitEscrowConfig = invoke(&e, &escrow, "config", ().into_val(&e));
+        assert_eq!(c.underlying, pending.margin_asset);
+        assert_eq!(c.share, pending.base_asset);
+        assert!(
+            pending.borrow_amount > 0 && pending.borrow_amount <= max_borrow,
+            "borrow bound"
+        );
+        Self::assert_market_not_borrow_paused(&e, &vaults.debt_vault);
+        let reserve: Option<u32> = invoke(
+            &e,
+            &vaults.debt_vault,
+            "get_min_cash_reserve_bps",
+            ().into_val(&e),
+        );
+        assert!(reserve.is_some(), "prototype reserve required");
+        assert!(
+            invoke::<bool>(
+                &e,
+                &vaults.debt_vault,
+                "get_cash_borrowing_enabled",
+                ().into_val(&e)
+            ),
+            "cash borrowing disabled"
+        );
+        let me = e.current_contract_address();
+        let token = token::Client::new(&e, &pending.margin_asset);
+        let before = token.balance(&me);
+        Self::authorize_controller_subcall(
+            &e,
+            &pending.margin_vault,
+            "withdraw",
+            (me.clone(), pending.margin_ptokens).into_val(&e),
+        );
+        Self::begin_margin_withdraw_if_supported(
+            &e,
+            &pending.margin_vault,
+            &me,
+            &me,
+            pending.margin_ptokens,
+        );
+        ReceiptVaultClient::new(&e, &pending.margin_vault).withdraw(&me, &pending.margin_ptokens);
+        let margin = token
+            .balance(&me)
+            .checked_sub(before)
+            .expect("margin decrease");
+        assert!(margin > 0, "margin missing");
+        Self::authorize_controller_subcall(
+            &e,
+            &vaults.debt_vault,
+            "borrow_for_margin_to_controller",
+            (id, pending.borrow_amount).into_val(&e),
+        );
+        ReceiptVaultClient::new(&e, &vaults.debt_vault)
+            .borrow_for_margin_to_controller(&id, &pending.borrow_amount);
+        let total = (margin as u128).checked_add(pending.borrow_amount).unwrap();
+        assert!(total <= max_input, "input bound");
+        let total_i: i128 = total.try_into().unwrap();
+        assert_eq!(token.balance(&me) - before, total_i, "borrow cash delta");
+        Self::authorize_controller_subcall(
+            &e,
+            &pending.margin_asset,
+            "transfer",
+            (me.clone(), escrow.clone(), total_i).into_val(&e),
+        );
+        invoke::<()>(
+            &e,
+            &escrow,
+            "fund",
+            (id, user.clone(), total, pending.expires_at).into_val(&e),
+        );
+        assert_eq!(token.balance(&me), before, "controller dust changed");
+        invoke::<()>(
+            &e,
+            &vaults.debt_vault,
+            "assert_borrowing_reserve",
+            ().into_val(&e),
+        );
+        save(
+            &e,
+            id,
+            &SplitOpen {
+                owner: user,
+                escrow,
+                margin_received: margin as u128,
+                phase: 1,
+                deadline: pending.expires_at,
+            },
+        );
+    }
+    pub fn split_convert(e: Env, user: Address, id: u64, input: u128, min_out: u128) -> u128 {
+        let mut j = owned(&e, &user, id);
+        convert_job(&e, &mut j, id, input, min_out)
+    }
+    /// Combined candidate: conversion then incumbent fee checkpoint atomically.
+    pub fn split_convert_prepare(
+        e: Env,
+        user: Address,
+        id: u64,
+        input: u128,
+        min_out: u128,
+    ) -> BytesN<32> {
+        let mut j = owned(&e, &user, id);
+        convert_job(&e, &mut j, id, input, min_out);
+        prepare_job(&e, &mut j, id)
+    }
+    pub fn split_prepare(e: Env, user: Address, id: u64) -> BytesN<32> {
+        let mut j = owned(&e, &user, id);
+        prepare_job(&e, &mut j, id)
+    }
+    pub fn split_mint(e: Env, user: Address, id: u64, min_shares: u128) -> u128 {
+        let mut j = owned(&e, &user, id);
+        assert_eq!(j.phase, 3);
+        let pending = get_pending_perps_open_position_or_panic(&e, id);
+        assert!(
+            min_shares >= pending.min_position_amount,
+            "share floor weakened"
+        );
+        let out: u128 = invoke(&e, &j.escrow, "mint", (id, min_shares).into_val(&e));
+        j.phase = 4;
+        save(&e, id, &j);
+        out
+    }
+    pub fn split_deliver(e: Env, user: Address, id: u64) -> u128 {
+        let mut j = owned(&e, &user, id);
+        assert_eq!(j.phase, 4);
+        let pending = get_pending_perps_open_position_or_panic(&e, id);
+        let me = e.current_contract_address();
+        let token = token::Client::new(&e, &pending.base_asset);
+        let before = token.balance(&me);
+        let amount: u128 = invoke(&e, &j.escrow, "deliver", (id,).into_val(&e));
+        assert_eq!(token.balance(&me) - before, i128::try_from(amount).unwrap());
+        Self::cl_assign(&e, &pending.base_asset, &user, amount, false);
+        set_pending_perps_open_execution(
+            &e,
+            id,
+            &PendingPerpsOpenExecution {
+                margin_received: j.margin_received,
+                position_amount: amount,
+            },
+        );
+        j.phase = 5;
+        save(&e, id, &j);
+        amount
+    }
+    pub fn split_recover(e: Env, user: Address, id: u64, max_repay: u128) -> u128 {
+        let mut j = owned(&e, &user, id);
+        assert!(j.phase >= 1 && j.phase <= 5, "not recoverable");
+        let paid = if j.phase == 5 {
+            Self::recover_pending_open_funded_impl(&e, user.clone(), id, max_repay)
+        } else {
+            let pending = get_pending_perps_open_position_or_panic(&e, id);
+            let debt = ReceiptVaultClient::new(&e, &pending.debt_vault);
+            let paid = debt.repay_full_for_margin(&id, &user, &max_repay);
+            assert_eq!(debt.get_margin_borrow_balance(&id), 0, "debt remains");
+            let _: Vec<u128> = invoke(&e, &j.escrow, "release", (id, user.clone()).into_val(&e));
+            let refund = get_fee_terms(&e, id)
+                .map(|f| f.open_fee_ptokens)
+                .unwrap_or(0);
+            if refund > 0 {
+                accrue_user_fee(&e, &user, &pending.margin_vault);
+                let free = get_margin_balance_ptokens(&e, &user, &pending.margin_vault);
+                set_margin_balance_ptokens(
+                    &e,
+                    &user,
+                    &pending.margin_vault,
+                    free.checked_add(refund).unwrap(),
+                );
+                update_total_margin_ptokens(&e, &pending.margin_vault, refund, true);
+            }
+            clear_perps_v3_position_storage(&e, id);
+            remove_user_position(&e, &user, id);
+            paid
+        };
+        j.phase = 6;
+        save(&e, id, &j);
+        paid
+    }
+}
