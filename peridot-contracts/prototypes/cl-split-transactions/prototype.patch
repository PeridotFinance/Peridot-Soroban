+// ISOLATED SPLIT EXPERIMENT ONLY. This source lives in target/cl-split-workspace;
+// it is not a production ABI and deliberately preserves conservative failures.
+#[soroban_sdk::contracttype]
+#[derive(Clone)]
+enum SplitKey {
+    Prepared(Address, u64),
+    Consumed(Address, u64),
+}
+#[soroban_sdk::contracttype]
+#[derive(Clone)]
+struct SplitPrepared {
+    fence: BytesN<32>,
+    deadline: u64,
+}
+
+impl ClShareVault {
+    fn split_validation_only(env: &Env) {
+        let public = env.crypto().sha256(&soroban_sdk::Bytes::from_slice(
+            env, b"Public Global Stellar Network ; September 2015",
+        ));
+        assert_ne!(env.ledger().network_id(), public.to_bytes(), "split prototype: Mainnet disabled");
+    }
+
+    fn split_state_fence(env: &Env) -> BytesN<32> {
+        use soroban_sdk::xdr::ToXdr;
+        Self::split_validation_only(env);
+        Self::require_not_paused(env);
+        let cfg = config(env);
+        let pool = ConcentratedPoolClient::new(env, &cfg.pool);
+        assert!(!pool.get_is_killed_deposit() && !pool.get_is_killed_swap(), "split pool paused");
+        let me = env.current_contract_address();
+        let owned = pool.get_user_position_snapshot(&me);
+        assert!(owned.ranges.len() <= 1, "split unknown extra ranges");
+        if let Some(range) = owned.ranges.get(0) {
+            assert!(range.tick_lower == cfg.tick_lower && range.tick_upper == cfg.tick_upper, "split wrong owned range");
+        }
+        let position = pool.get_position(&me, &cfg.tick_lower, &cfg.tick_upper);
+        assert_eq!(position.liquidity, Self::position_liquidity(env), "split liquidity cache mismatch");
+        assert_eq!(owned.raw_liquidity, position.liquidity, "split unaccounted position");
+        let fees = pool.get_all_position_fees(&me);
+        assert!(fees.len() == 2 && fees.get(0) == Some(0) && fees.get(1) == Some(0), "split uncollected fees");
+        assert!(position.tokens_owed_0 == 0 && position.tokens_owed_1 == 0, "split owed fees");
+        let code = match cfg.pool.executable() {
+            Some(soroban_sdk::Executable::Wasm(hash)) => hash,
+            _ => panic!("split pool must be WASM"),
+        };
+        let mut parts: Vec<Val> = Vec::new(env);
+        parts.push_back(cfg.clone().into_val(env));
+        parts.push_back(params(env).into_val(env));
+        parts.push_back(range_params(env).into_val(env));
+        parts.push_back(code.into_val(env));
+        parts.push_back(pool.get_fee_fraction().into_val(env));
+        parts.push_back(pool.get_protocol_fee_fraction().into_val(env));
+        parts.push_back(pool.get_tick_spacing().into_val(env));
+        let tokens = pool.get_tokens();
+        assert!(tokens.len() == 2 && tokens.get(0) == Some(cfg.token0.clone())
+            && tokens.get(1) == Some(cfg.token1.clone()), "split token config changed");
+        parts.push_back(tokens.into_val(env));
+        parts.push_back(oracle_symbol(env, &cfg.token0).into_val(env));
+        parts.push_back(oracle_symbol(env, &cfg.token1).into_val(env));
+        parts.push_back(pool.get_fee_growth_global_0_x128().into_val(env));
+        parts.push_back(pool.get_fee_growth_global_1_x128().into_val(env));
+        parts.push_back(pool.get_tick(&cfg.tick_lower).into_val(env));
+        parts.push_back(pool.get_tick(&cfg.tick_upper).into_val(env));
+        parts.push_back(pool.get_slot0().into_val(env));
+        parts.push_back(pool.get_active_liquidity().into_val(env));
+        parts.push_back(position.into_val(env));
+        parts.push_back(owned.into_val(env));
+        // Ownership may change between stages; fresh NAV/supply and claims below
+        // handle it. Fee growth, actual position, pool code/config may not change.
+        env.crypto().sha256(&parts.to_xdr(env)).to_bytes()
+    }
+
+    fn split_fresh_root(env: &Env) -> u128 {
+        let cfg = config(env);
+        let prm = params(env);
+        let pu = Self::read_price(env, &cfg.oracle, &Self::underlying(env), prm.oracle_max_age_mult)
+            .expect("split underlying oracle unavailable");
+        let po = Self::read_price(env, &cfg.oracle, &Self::other_token(env), prm.oracle_max_age_mult)
+            .expect("split paired oracle unavailable");
+        assert!(pu > 0 && po > 0, "split zero oracle");
+        let ratio = try_mul_div(env, po, NAV_RATIO_SCALE, pu).and_then(|v|
+            try_mul_div(env, v, pow10(Self::decimals_at(&cfg, cfg.underlying_index)),
+                pow10(Self::decimals_at(&cfg, 1-cfg.underlying_index))))
+            .expect("split oracle ratio overflow");
+        let root = isqrt(ratio);
+        assert!(root > 0, "split zero root");
+        let mut st = state(env);
+        st.last_nav_root = root;
+        st.last_nav_root_at = env.ledger().timestamp();
+        set_state(env, &st);
+        root
+    }
+}
+
+#[contractimpl]
+impl ClShareVault {
+    pub fn split_assets(env: Env) -> (Address, Address, Address, u32) {
+        Self::split_validation_only(&env);
+        (Self::pool(&env), Self::underlying(&env), Self::other_token(&env), Self::underlying_index(&env))
+    }
+
+    pub fn split_fence(env: Env) -> BytesN<32> {
+        Self::split_state_fence(&env)
+    }
+
+    /// Fresh same-transaction conversion floor for the external escrow. Its
+    /// subsequent pool swap must execute in the same transaction and enforce
+    /// this floor along with the user's own (possibly stricter) minimum.
+    pub fn split_quote_convert(env: Env, amount_u: u128) -> u128 {
+        Self::split_validation_only(&env);
+        Self::require_not_paused(&env);
+        assert!(amount_u > 0 && amount_u <= i128::MAX as u128, "split conversion amount");
+        let root = Self::split_fresh_root(&env);
+        let pool = ConcentratedPoolClient::new(&env, &Self::pool(&env));
+        assert!(!pool.get_is_killed_swap() && !pool.get_is_killed_deposit(), "split pool paused");
+        let u = Self::underlying_index(&env);
+        let estimate = pool.estimate_swap(&u, &(1-u), &amount_u);
+        assert!(estimate > 0, "split conversion unavailable");
+        Self::require_quote_near_oracle(&env, u, amount_u, estimate, Some(root),
+            params(&env).max_pool_divergence_bps, false);
+        apply_slippage_floor(&env, estimate, Self::slippage_bps(&env))
+    }
+
+    /// Must follow conversion in the same escrow preparation transaction.
+    /// Repreparing this same job can refresh the fence but never extend its deadline.
+    pub fn split_prepare(env: Env, escrow: Address, job: u64, deadline: u64) -> BytesN<32> {
+        Self::split_validation_only(&env);
+        Self::require_not_paused(&env);
+        escrow.require_auth();
+        assert!(crate::custody::registered(&env, &escrow), "split escrow not registered");
+        assert!(!env.storage().persistent().has(&SplitKey::Consumed(escrow.clone(), job)), "split job consumed");
+        assert!(deadline > env.ledger().timestamp() && deadline <= env.ledger().timestamp().checked_add(86400).unwrap(), "split deadline invalid");
+        let key = SplitKey::Prepared(escrow.clone(), job);
+        if let Some(old) = env.storage().persistent().get::<_, SplitPrepared>(&key) {
+            assert_eq!(old.deadline, deadline, "split deadline immutable");
+        }
+        crate::accounting::begin(&env);
+        Self::collect_fees(&env);
+        let fence = Self::split_state_fence(&env);
+        env.storage().persistent().set(&key, &SplitPrepared { fence: fence.clone(), deadline });
+        env.storage().persistent().extend_ttl(&key, 500_000, 1_000_000);
+        crate::accounting::end(&env);
+        fence
+    }
+
+    /// Isolated pair deposit; no pre-existing vault balances are offered to the
+    /// pool. Registered escrow owns the lifecycle and authenticates its job.
+    pub fn split_deposit_pair(env: Env, escrow: Address, owner: Address, job: u64,
+        amount_u: u128, amount_o: u128, min_shares: u128, fence: BytesN<32>) -> i128 {
+        Self::split_validation_only(&env);
+        Self::require_not_paused(&env);
+        escrow.require_auth();
+        assert!(crate::custody::registered(&env, &escrow), "split escrow not registered");
+        assert!(!crate::custody::registered(&env, &owner), "split beneficiary is custodian");
+        let used = SplitKey::Consumed(escrow.clone(), job);
+        assert!(!env.storage().persistent().has(&used), "split job consumed");
+        let key = SplitKey::Prepared(escrow.clone(), job);
+        let prepared: SplitPrepared = env.storage().persistent().get(&key).expect("split not prepared");
+        assert!(env.ledger().timestamp() < prepared.deadline, "split expired");
+        assert_eq!(prepared.fence, fence, "split wrong job fence");
+        assert_eq!(Self::split_state_fence(&env), fence, "split fee/config fence changed");
+        assert!(amount_u > 0 && amount_o > 0 && min_shares > 0, "split invalid pair/minimum");
+        crate::accounting::begin(&env);
+        // Original mint-boundary actual claim retained. Beneficiary allocation
+        // below performs an additional actual claim rather than bypassing it.
+        crate::rewards::normal(&env, &owner);
+        let root = Self::split_fresh_root(&env);
+        assert!(Self::refresh_position_amounts_inner(&env), "split composition unavailable");
+        let underlying = Self::underlying(&env);
+        let other = Self::other_token(&env);
+        let pool = ConcentratedPoolClient::new(&env, &Self::pool(&env));
+        let estimate = pool.estimate_swap(&Self::underlying_index(&env), &(1-Self::underlying_index(&env)), &amount_u);
+        Self::require_quote_near_oracle(&env, Self::underlying_index(&env), amount_u,
+            estimate, Some(root), params(&env).max_pool_divergence_bps, true);
+        let nav_before = Self::total_underlying_full_at_root(&env, root);
+        let supply = Self::total_shares(&env);
+        let u_before = Self::balance_of_token(&env, &underlying);
+        let o_before = Self::balance_of_token(&env, &other);
+        let max_deploy = params(&env).max_deploy;
+        if max_deploy > 0 {
+            let offered_value = amount_u.checked_add(Self::other_amount_value_at_root(&env, amount_o, root)).unwrap();
+            assert!(Self::position_value_at_root(&env, root, true).checked_add(offered_value).unwrap() <= max_deploy, "split deployment cap");
+        }
+        let me = env.current_contract_address();
+        token::Client::new(&env, &underlying).transfer(&escrow, &me, &to_i128(amount_u));
+        token::Client::new(&env, &other).transfer(&escrow, &me, &to_i128(amount_o));
+        let u_after = Self::balance_of_token(&env, &underlying);
+        let o_after = Self::balance_of_token(&env, &other);
+        assert_eq!(u_after, u_before.checked_add(amount_u).unwrap(), "split underlying receipt mismatch");
+        assert_eq!(o_after, o_before.checked_add(amount_o).unwrap(), "split paired receipt mismatch");
+        let result = Self::deposit_balances(&env, amount_u, amount_o, u_after, o_after);
+        assert!(result.minted > 0, "split position not minted");
+        let nav_after = Self::total_underlying_full_from_balances(&env, result.idle_underlying, result.idle_other);
+        let added = nav_after.checked_sub(nav_before).expect("split negative added value");
+        assert!(added > 0, "split zero added value");
+        let minted = if supply == 0 {
+            assert_eq!(nav_before, 0, "split unowned NAV");
+            added
+        } else {
+            assert!(nav_before > 0, "split insolvent supply");
+            mul_div(&env, added, supply, nav_before)
+        };
+        assert!(minted >= min_shares && minted > 0, "split minimum shares");
+        Self::mint_shares(&env, &escrow, minted);
+        crate::custody::assign(&env, &escrow, &owner, minted, false);
+        crate::rewards::reset_debt(&env, &owner);
+        env.storage().persistent().set(&used, &true);
+        env.storage().persistent().extend_ttl(&used, 500_000, 1_000_000);
+        env.storage().persistent().remove(&key);
+        crate::accounting::end(&env);
+        to_i128(minted)
+    }
+}
